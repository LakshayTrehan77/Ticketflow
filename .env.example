# copy this file to .env and change the values
DATABASE_URL=sqlite:///./ticketflow.db
# leave empty to use the in-memory cache
REDIS_URL=
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# comma separated list, these emails get the "agent" role when they register
AGENT_EMAILS=agent@example.com
MODEL_PATH=ml/artifacts/classifier.joblib
